// Invoice app data layer. Connection URLs live in prisma.config.ts (Prisma 7);
// the runtime client uses the pg driver adapter (lib/db.ts).

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// CNH is only used by balance-sheet accounts; invoices stay on the other five.
enum Currency {
  USD
  HKD
  CNY
  EUR
  SGD
  CNH
}

enum Language {
  EN
  ZH
}

/// Who produced the invoice: the STAR SAAS billing system (email PDF) or us.
enum Generate {
  SYSTEM
  MANUAL
}

enum InvoiceStatus {
  SENT
  PAID
  END
  LOST
  WAIVED
}

/**
 * ------------------------------- Users -------------------------------
 */

/// Superseded by AppRole; kept until the deployed app stops reading User.role.
enum Role {
  ADMIN
  STAFF
  VIEWER
}

/// OWNER: full access and the only one who can manage Owners. ADMIN: fixed
/// preset, everything except editing the cash book and statement imports.
enum SystemRole {
  OWNER
  ADMIN
}

/// A role and the access it grants per feature (see FEATURES in lib/roles.ts).
model AppRole {
  id          String      @id @default(cuid())
  name        String      @unique
  description String      @default("")
  /// Set on the two fixed roles; their permissions come from code, not `permissions`.
  system      SystemRole? @unique
  /// { feature: "NONE" | "VIEW" | "EDIT" }
  permissions Json        @default("{}")
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  users User[]
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String
  legacyRole     Role      @default(STAFF) @map("role")
  roleId         String    @default("role_staff")
  role           AppRole   @relation(fields: [roleId], references: [id], onDelete: Restrict)
  passwordHash   String
  active         Boolean   @default(true)
  /// Bumped on password change or deactivation; sessions carrying an older
  /// value are rejected, which signs the user out everywhere.
  sessionVersion Int       @default(0)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  /// Authenticator-app (TOTP) secret, base32. Required on every sign-in;
  /// users without one enrol on their next sign-in.
  totpSecret        String?
  totpEnabledAt     DateTime?
  /// Secret being enrolled, promoted to totpSecret once a code confirms it.
  totpPendingSecret String?
  /// Emailed one-time sign-in code ("Sign in another way"), sha256.
  emailCodeHash     String?
  emailCodeSentAt   DateTime?
  /// Wrong codes since the last successful sign-in; too many ends the attempt.
  mfaFailures       Int       @default(0)

  /// Pending invitation: sha256 of the emailed /invite token. Cleared once
  /// accepted; until then passwordHash is empty and sign-in is refused.
  inviteTokenHash String?   @unique
  inviteExpiresAt DateTime?
  invitedAt       DateTime?
  invitedById     String?

  invoicesCreated    Invoice[]            @relation("InvoiceCreatedBy")
  invoicesUpdated    Invoice[]            @relation("InvoiceUpdatedBy")
  resetTokens        PasswordResetToken[]
  importDecisions    ImportReview[]
  statementUploads   StatementImport[]    @relation("StatementUploads")
  statementDecisions StatementLine[]      @relation("StatementDecisions")
}

/// Who changed what. Append-only: rows are never edited or deleted. No foreign
/// keys, so entries outlive the records and users they mention.
model ActivityLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  actorId   String?
  /// Name or email at the time, kept in case the user is renamed.
  actorName String
  /// create | update | delete, or a verb such as approve, reject, mark_paid.
  action    String
  /// invoice, client, user, role, setting:<entity>, cash_entry, statement, import ...
  entity    String
  entityId  String?
  /// Human label for the record, e.g. the invoice number or client name.
  label     String   @default("")
  /// { field: [before, after] } for updates; extra detail otherwise.
  changes   Json?

  @@index([createdAt])
  @@index([entity, entityId])
  @@index([actorId])
}

/// One-time "forgot password" link; only the sha256 of the token is kept.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/**
 * ----------------------------- Settings -----------------------------
 */

/// Issuer on the letterhead (SPARK PSP, STAR SAAS, 厦门星知付).
model Company {
  id           String   @id @default(cuid())
  code         String   @unique
  legalName    String
  addressLines String[]
  /// Public path of the letterhead logo, e.g. /logos/star.png.
  logoPath     String?
  defaultLang  Language @default(EN)
  termsEn      String[]
  termsZh      String[]
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  /// False for companies that only hold cash (Moonlink): hidden from the letterhead picker.
  invoicing    Boolean  @default(true)

  paymentRules PaymentRule[]
  invoices     Invoice[]
  bankAccounts BankAccount[]
}

/// Where a bank account appears: the invoice payment picker, the balance sheet, or both.
enum AccountUse {
  INVOICE
  BALANCE
  BOTH
}

model BankAccount {
  id              String     @id @default(cuid())
  /// Short label shown in pickers, e.g. "USD (SCB Bank)".
  label           String     @unique
  currency        Currency
  accountName     String
  accountNumber   String
  bankName        String     @default("")
  /// e.g. "ANEXT Business Account". Not printed on invoices.
  accountType     String     @default("")
  bankAddress     String     @default("")
  bankCode        String     @default("")
  branchCode      String     @default("")
  swiftCode       String     @default("")
  accountLocation String     @default("")
  /// Compact accounts (e.g. Airwallex) print only name + number.
  compact         Boolean    @default(false)
  sortOrder       Int        @default(0)
  active          Boolean    @default(true)
  use             AccountUse @default(INVOICE)
  /// Company whose cash this is, for the balance sheet.
  companyId       String?
  company         Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)

  paymentRules   PaymentRule[]
  invoices       Invoice[]
  cashTxns       CashTxn[]
  cashHints      CashHint[]
  statements     StatementImport[]
  statementLines StatementLine[]
}

/// Default payment account. The most specific match wins:
/// company + currency, then company only, then currency only.
model PaymentRule {
  id            String      @id @default(cuid())
  companyId     String?
  company       Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  currency      Currency?
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)

  @@unique([companyId, currency])
}

/// How many USD one unit of the currency is worth.
model FxRate {
  currency   Currency @id
  usdPerUnit Decimal  @db.Decimal(18, 8)
  /// "YAHOO" when pulled from Yahoo Finance, "MANUAL" when typed in Settings.
  source     String   @default("MANUAL")
  updatedAt  DateTime @updatedAt
}

model Owner {
  id        String    @id @default(cuid())
  name      String    @unique
  /// Used on new invoices when the client has no default owner.
  isDefault Boolean   @default(false)
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  clients   Client[]
  invoices  Invoice[]
}

model InvoiceType {
  id          String        @id @default(cuid())
  name        String        @unique
  /// What the free-text subtype should say for this type.
  subtypeHint String?
  sortOrder   Int           @default(0)
  active      Boolean       @default(true)
  invoices    Invoice[]
  items       InvoiceItem[]
}

model InvoiceItem {
  id         String        @id @default(cuid())
  labelEn    String
  labelZh    String        @default("")
  /// Prompt for the detail line, e.g. "Month :" or "Channel :".
  detailHint String?
  /// Client fee field (Jotform header) that prices this item, if any.
  clientFee  String?
  /// Ledger type an invoice gets when this is its first line.
  typeId     String?
  type       InvoiceType?  @relation(fields: [typeId], references: [id], onDelete: SetNull)
  /// Default subtype; {month} becomes the invoice month, e.g. SEPT 2026.
  subtype    String        @default("")
  sortOrder  Int           @default(0)
  active     Boolean       @default(true)
  lines      InvoiceLine[]
}

/**
 * ------------------------------ Clients ------------------------------
 */

model Client {
  id              String    @id @default(cuid())
  name            String    @unique
  alias           String    @default("")
  agreementNo     String    @default("")
  agreementDate   DateTime? @db.Date
  /// Further agreements (e.g. a PCI or VCC agreement next to the Whitelabel
  /// one); each can be picked as an invoice reference.
  otherAgreements String[]  @default([])
  country         String    @default("")
  incorporationNo String    @default("")
  address1        String    @default("")
  address2        String    @default("")
  address3        String    @default("")
  city            String    @default("")
  directorName    String    @default("")
  contactTitle    String    @default("")
  contactEmail    String    @default("")
  websiteUrls     String    @default("")
  /// Payer name when funds arrive under a different name.
  transferName    String    @default("")
  defaultOwnerId  String?
  defaultOwner    Owner?    @relation(fields: [defaultOwnerId], references: [id], onDelete: SetNull)
  /// Fee schedule keyed by the Jotform column header.
  fees            Json      @default("{}")
  jotformId       String?   @unique
  submittedAt     DateTime?
  notes           String    @default("")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  invoices      Invoice[]
  importReviews ImportReview[]
  credits       ClientCredit[]
}

/// A client's credit history per currency: money received beyond what the invoices
/// took (positive) and credit used on later invoices (negative). The balance is the sum.
model ClientCredit {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  currency    Currency
  amount      Decimal  @db.Decimal(14, 2)
  /// The day the money arrived; credit used on an invoice keeps that payment's date.
  date        DateTime @db.Date
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  note        String   @default("")
  createdById String?
  createdAt   DateTime @default(now())

  @@index([clientId, currency])
  @@index([invoiceId])
}

/**
 * ------------------------------ Invoices -----------------------------
 */

model Invoice {
  id       String        @id @default(cuid())
  /// Not unique: one invoice can be split into rows by type, and the legacy
  /// ledger reused numbers. New numbers are checked for reuse in the app.
  number   String
  clientId String
  client   Client        @relation(fields: [clientId], references: [id], onDelete: Restrict)
  alias    String        @default("")
  ownerId  String?
  owner    Owner?        @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  typeId   String?
  type     InvoiceType?  @relation(fields: [typeId], references: [id], onDelete: SetNull)
  subtype  String        @default("")
  generate Generate      @default(MANUAL)
  status   InvoiceStatus @default(SENT)

  invoiceDate DateTime  @db.Date
  dueDate     DateTime? @db.Date
  billingFrom DateTime? @db.Date
  billingTo   DateTime? @db.Date
  reference   String    @default("")

  /// Currency the invoice lines are priced in.
  currency    Currency  @default(USD)
  amount      Decimal   @db.Decimal(14, 2)
  /// Booked USD equivalent — the figure every total and KPI uses.
  usdAmount   Decimal   @db.Decimal(14, 2)
  fxRate      Decimal?  @db.Decimal(18, 8)
  /// Included in amount (amount = line subtotal + tax).
  taxAmount   Decimal   @default(0) @db.Decimal(14, 2)
  /// Already paid before this invoice; amount due = amount - amountPaid.
  amountPaid  Decimal   @default(0) @db.Decimal(14, 2)
  /// Optional second "amount due" line in another currency.
  altCurrency Currency?
  altAmount   Decimal?  @db.Decimal(14, 2)
  /// Billed-to block as printed: { name, attention, lines[] }. Kept so a
  /// later client address change does not alter issued invoices.
  billTo      Json?

  receivedDate     DateTime? @db.Date
  /// USD equivalent received, net of fee. receivedCurrency records what
  /// actually arrived when it was not USD.
  receivedAmount   Decimal?  @db.Decimal(14, 2)
  receivedCurrency Currency?
  /// Bank or transfer fee in USD.
  fee              Decimal?  @db.Decimal(14, 2)
  paymentNote      String    @default("")

  companyId       String?
  company         Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  language        Language     @default(EN)
  bankAccountId   String?
  bankAccount     BankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  extraAccountIds String[]

  notes           String   @default("")
  /// Row number in the Excel Invoice List, for tracing imported rows.
  legacyNo        Int?     @unique
  sourceMessageId String?  @unique
  /// Null on rows from the workbook import or the scheduled mailbox import.
  createdById     String?
  createdBy       User?    @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById     String?
  updatedBy       User?    @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  lines    InvoiceLine[]
  document InvoiceDocument?
  cashTxns CashTxn[]
  credits  ClientCredit[]

  @@index([number])
  @@index([status])
  @@index([invoiceDate])
  @@index([clientId])
}

model InvoiceLine {
  id          String       @id @default(cuid())
  invoiceId   String
  invoice     Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemId      String?
  item        InvoiceItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  category    String       @default("")
  description String
  detail      String       @default("")
  quantity    Decimal      @db.Decimal(18, 4)
  rate        Decimal      @db.Decimal(18, 6)
  amount      Decimal      @db.Decimal(14, 2)
  sortOrder   Int          @default(0)
}

/// Original PDF for system invoices received by email.
enum DocumentSource {
  /// Rendered by this app when the invoice was issued.
  GENERATED
  /// The billing system's own PDF, from the mailbox or an upload.
  IMPORTED
}

/// The PDF of record for an invoice. Kept on Google Drive once connected;
/// `data` holds the bytes only until the upload is confirmed.
model InvoiceDocument {
  id            String         @id @default(cuid())
  invoiceId     String         @unique
  invoice       Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  filename      String
  contentType   String         @default("application/pdf")
  source        DocumentSource @default(IMPORTED)
  data          Bytes?
  size          Int?
  driveFileId   String?
  driveFolderId String?
  driveName     String?
  syncedAt      DateTime?
  syncError     String         @default("")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
}

/// Drive files whose invoice was deleted but which could not be trashed yet.
model DriveTrash {
  fileId    String   @id
  createdAt DateTime @default(now())
}

/// Small app-wide values, e.g. the Google Drive connection.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/**
 * --------------------------- Email import ----------------------------
 */

enum ReviewStatus {
  /// Waiting for someone to approve or reject it.
  PENDING
  IMPORTED
  /// Rejected by a user; later emails with the same invoice number are flagged, not re-queued.
  DISMISSED
  /// The invoice number was already on the ledger.
  DUPLICATE
}

/// A system-invoice PDF (from the mailbox or an upload). Nothing reaches the
/// ledger until a user approves it.
model ImportReview {
  id            String       @id @default(cuid())
  messageId     String       @unique
  subject       String       @default("")
  receivedAt    DateTime?
  filename      String       @default("")
  pdf           Bytes?
  parsed        Json?
  invoiceNumber String?
  /// Client the importer matched; the reviewer can change it before approving.
  clientId      String?
  client        Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  /// Empty when the invoice is ready to approve; otherwise what needs attention.
  reason        String
  status        ReviewStatus @default(PENDING)
  invoiceId     String?
  decidedAt     DateTime?
  decidedById   String?
  decidedBy     User?        @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([status])
  @@index([invoiceNumber])
}

/**
 * ----------------------------- Cash book -----------------------------
 */

/// INCOME and EXPENSE count towards profit; TRANSFER moves cash without it.
enum CashKind {
  INCOME
  EXPENSE
  TRANSFER
}

/// The 摘要 column of the balance sheet workbook.
model CashCategory {
  id             String          @id @default(cuid())
  nameZh         String          @unique
  nameEn         String          @default("")
  kind           CashKind
  sortOrder      Int             @default(0)
  active         Boolean         @default(true)
  txns           CashTxn[]
  statementLines StatementLine[]
}

/// One bank line, in the account's own currency. USD is worked out on totals
/// with the latest rate, never stored per line.
model CashTxn {
  id          String        @id @default(cuid())
  accountId   String
  account     BankAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  date        DateTime      @db.Date
  /// 使用月: first day of the month the line belongs to on the monthly statement,
  /// e.g. salary paid on 10 Sept for August work. Usually the month of `date`.
  period      DateTime      @db.Date
  /// Order within the account on the same date (the workbook's row order).
  seq         Int           @default(0)
  categoryId  String?
  category    CashCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// 用途: client name on receipts, expense detail otherwise.
  purpose     String        @default("")
  /// The workbook's "Paid Invoice" column: client, person or company.
  party       String        @default("")
  /// 发票号码: free-text reference.
  memo        String        @default("")
  amountIn    Decimal       @default(0) @db.Decimal(16, 2)
  amountOut   Decimal       @default(0) @db.Decimal(16, 2)
  invoiceId   String?
  invoice     Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  /// Workbook sheet and row the line came from, so the import can be re-run.
  sourceSheet String?
  sourceRow   Int?
  /// Set on lines added from a bank statement, so the same statement can be imported again safely.
  importKey   String?       @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([sourceSheet, sourceRow])
  @@index([accountId, date])
  @@index([date])
  @@index([period])
  @@index([categoryId])
  @@index([invoiceId])
}

/// What a bank statement counterparty (e.g. "CENTRAL PROVIDENT FUND BOARD") was booked as,
/// learned when statement entries match cash book lines. Kept apart from CashTxn so workbook
/// re-imports don't erase it.
model CashHint {
  id           String      @id @default(cuid())
  accountId    String
  account      BankAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  counterparty String
  /// "in" or "out".
  direction    String
  categoryId   String?
  purpose      String      @default("")
  party        String      @default("")
  /// Months the 使用月 lies before the date, e.g. 1 for salary paid on 10 Sept for August.
  periodLag    Int         @default(0)
  updatedAt    DateTime    @updatedAt

  @@unique([accountId, counterparty, direction])
}

/// One uploaded bank statement month, kept so its balances can be checked against the cash book.
model StatementImport {
  /// "BANK:accountNumber:CUR:yyyy-mm", the prefix of its lines' keys.
  id           String          @id
  accountId    String
  account      BankAccount     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  file         String          @default("")
  currency     String
  periodStart  DateTime        @db.Date
  periodEnd    DateTime        @db.Date
  opening      Decimal         @db.Decimal(16, 2)
  closing      Decimal         @db.Decimal(16, 2)
  uploadedAt   DateTime        @default(now())
  uploadedById String?
  uploadedBy   User?           @relation("StatementUploads", fields: [uploadedById], references: [id], onDelete: SetNull)
  lines        StatementLine[]

  @@index([accountId, periodStart])
}

enum StatementLineStatus {
  /// Waiting for someone to approve or reject it.
  PENDING
  /// Added to the cash book.
  IMPORTED
  /// Rejected; uploading the statement again doesn't queue it again.
  REJECTED
  /// The workbook now has this entry, so the workbook's line is used instead.
  IN_EXCEL
}

/// A line from a bank statement that the cash book doesn't have yet. Nothing reaches the
/// cash book until a user approves it.
model StatementLine {
  id           String              @id @default(cuid())
  /// Same as CashTxn.importKey once approved.
  key          String              @unique
  statementId  String
  statement    StatementImport     @relation(fields: [statementId], references: [id], onDelete: Cascade)
  accountId    String
  account      BankAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  /// "opening", "interest" or "entry".
  kind         String
  date         DateTime            @db.Date
  /// 使用月 (first of the month); null means the month of `date`.
  period       DateTime?           @db.Date
  amountIn     Decimal             @default(0) @db.Decimal(16, 2)
  amountOut    Decimal             @default(0) @db.Decimal(16, 2)
  categoryId   String?
  category     CashCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  purpose      String              @default("")
  party        String              @default("")
  memo         String              @default("")
  /// The statement's own wording for the entry.
  description  String              @default("")
  counterparty String              @default("")
  /// "rule", "history" or "none": where the category came from.
  suggested    String              @default("none")
  status       StatementLineStatus @default(PENDING)
  cashTxnId    String?
  decidedAt    DateTime?
  decidedById  String?
  decidedBy    User?               @relation("StatementDecisions", fields: [decidedById], references: [id], onDelete: SetNull)
  createdAt    DateTime            @default(now())

  @@index([status])
  @@index([accountId])
}
