# Neon — pooled URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/invoice?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/invoice?sslmode=require"

# Users live in the database (Settings > Users). Create the first admin, or
# recover a locked-out account, with:
#   npm run user:create -- --email you@example.com --name "Your Name" --role ADMIN
# Any long random string; signs the session cookie.
SESSION_SECRET=""

# System-invoice mailbox (phase 6). Use an app password, not your main one.
IMAP_HOST=""
IMAP_PORT="993"
IMAP_USER=""
IMAP_PASSWORD=""
IMAP_FOLDER="INBOX"
# Only emails whose subject starts with this are read. Empty reads everything.
IMAP_SUBJECT_PREFIX="Invoice on"
# Shared secret for the scheduled import endpoint.
CRON_SECRET=""
